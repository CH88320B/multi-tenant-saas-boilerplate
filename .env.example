PORT=3000
APP_URL=http://localhost:3000
# App connects as app_user so PostgreSQL row-level security applies; migrations use the owner.
DATABASE_URL=postgres://app_user:app_user@localhost:5432/saas
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/saas
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1h
SMTP_URL=smtp://localhost:1025
MAIL_FROM="SaaS App <no-reply@example.com>"
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...
