{
  "name": "multi-tenant-saas-boilerplate",
  "version": "1.0.0",
  "description": "Multi-tenant SaaS backend: Express + PostgreSQL row-level security, roles, Stripe billing, email and per-tenant rate limiting",
  "main": "src/server.js",
  "private": true,
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "seed:superadmin": "node scripts/create-superadmin.js",
    "test": "jest --runInBand",
    "lint": "eslint src tests scripts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.15",
    "pg": "^8.13.0",
    "pino": "^9.4.0",
    "stripe": "^17.2.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "eslint": "^9.12.0",
    "globals": "^15.11.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "license": "MIT"
}
